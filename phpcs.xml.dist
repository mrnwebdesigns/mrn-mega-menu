<?xml version="1.0"?>
<ruleset name="MRN Mega Menu">
	<description>Release-readiness WordPress checks for MRN Mega Menu.</description>
	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="1"/>
	<arg name="extensions" value="php"/>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/zip/*</exclude-pattern>
	<exclude-pattern>*/outputs/*</exclude-pattern>
	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="Generic.PHP.Syntax"/>
	<rule ref="Generic.VersionControl.GitMergeConflict"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.SafeRedirect"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.WP.Capabilities"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.EnqueuedResourceParameters"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
</ruleset>
